    }

    h2 {
      margin-top: 35px;
      margin-bottom: 16px;
      padding-bottom: 6px;
      border-bottom: 2px solid #d7dee8;
      color: #22364f;
      font-size: 23px;
    }

    h2:first-child {
      margin-top: 0;
    }

    p {
      text-align: justify;
    }

    .tags {
      margin-top: 15px;
    }

    .tag {
      display: inline-block;
      margin: 5px 6px 5px 0;
      padding: 5px 12px;
      border: 1px solid #d4dee8;
      border-radius: 4px;
      background: #eef3f8;
      color: #22364f;
      font-size: 14px;
    }

    .info-list {
      padding-left: 0;
      list-style: none;
    }

    .info-list li {
      margin-bottom: 8px;
    }

    .paper {
      margin-bottom: 22px;
      padding-left: 14px;
      border-left: 4px solid #d7dee8;
    }

    .paper-title {
      font-weight: bold;
    }

    .paper-info {
      margin-top: 4px;
      color: #555;
    }

    a {
      color: #1c5d8c;
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    a:hover,
    a:focus-visible {
      text-decoration: underline;
    }

    .footer {
      padding: 18px;
      border-top: 1px solid #ddd;
      background: #f5f6f8;
      color: #666;
      text-align: center;
      font-size: 14px;
    }

    @media (max-width: 700px) {
      body {
        font-size: 15px;
      }

      .container {
        max-width: calc(100% - 24px);
        margin: 12px auto;
      }

      .top {
        padding: 30px 24px;
      }

      .name-cn {
        font-size: 32px;
      }

      .content {
        padding: 28px 24px 36px;
      }

      h2 {
        font-size: 21px;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="top">
      <div class="name-cn">陈友才</div>
      <div class="name-en">You-Cai Chen</div>
      <div class="position">
        博士后<br>
        中山大学 · 物理与天文学院<br>
        核物理与核天体物理课题组
      </div>
